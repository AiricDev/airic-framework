{
  "name": "airic-framework-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -b && pnpm run build:assets",
    "build:assets": "tsc -b packages/ui --force && vite build --config packages/ui/vite.config.ts && node packages/create-airic/scripts/copy-template.mjs && vite build --config templates/default/vite.config.ts",
    "check": "pnpm run architecture:check && tsc -b && pnpm test",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test": "vitest run",
    "test:browser": "pnpm --filter @airic/template-default test:browser",
    "pack:all": "node scripts/pack-all.mjs",
    "verify:pack": "node scripts/verify-packed-app.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  }
}
